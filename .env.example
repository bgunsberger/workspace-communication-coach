# Google OAuth desktop client downloaded from Google Cloud Console.
GOOGLE_OAUTH_CLIENT=credentials/oauth-client.json
GOOGLE_TOKEN_FILE=.tokens/google-workspace.json

# LLM report generation.
# Use "mock" for local/sandbox testing without a model provider account.
LLM_PROVIDER=mock
LLM_CREDENTIAL=
LLM_CREDENTIAL_TYPE=
LLM_MODEL=

# Optional defaults.
TIMEZONE_OFFSET=+10:00
REPORTS_DIR=reports
